<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Customer List View -->
    <record id="view_customer_list" model="ir.ui.view">
        <field name="name">business.customer.list</field>
        <field name="model">business.customer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="contact_number"/>
                <field name="email"/>
                <field name="customer_type"/>
            </list>
        </field>
    </record>

    <!-- Customer Form View -->
    <record id="view_customer_form" model="ir.ui.view">
        <field name="name">business.customer.form</field>
        <field name="model">business.customer</field>
        <field name="arch" type="xml">
            <form string="Customer">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="contact_number"/>
                        <field name="email"/>
                        <field name="address"/>
                        <field name="nic_br_number"/>
                        <field name="customer_type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Customer Action -->
    <record id="customer_action" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">business.customer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Customer Menu -->
    <menuitem id="customer_menu"
              name="Customers"
              parent="business_erp_root"
              action="customer_action"
              sequence="2"/>

</odoo>