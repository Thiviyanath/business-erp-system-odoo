<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_business_invoice_list" model="ir.ui.view">
        <field name="name">business.invoice.list</field>
        <field name="model">business.invoice</field>
        <field name="arch" type="xml">
            <list>
                <field name="invoice_number"/>
                <field name="customer_id"/>
                <field name="product_id"/>
                <field name="subtotal"/>
                <field name="vat_amount"/>
                <field name="grand_total"/>
                <field name="payment_status"/>
            </list>
        </field>
    </record>

    <record id="view_business_invoice_form" model="ir.ui.view">
        <field name="name">business.invoice.form</field>
        <field name="model">business.invoice</field>
        <field name="arch" type="xml">
            <form string="Invoice">

  <header>

    <button name="action_mark_paid"
            string="Mark as Paid"
            type="object"
            class="btn-primary"/>

    <button name="action_mark_unpaid"
            string="Mark as Unpaid"
            type="object"
            class="btn-secondary"/>
  </header>

                <sheet>
                    <group>
                        <field name="invoice_number"/>
                        <field name="sale_id"/>
                        <field name="customer_id"/>
                        <field name="product_id"/>
                    </group>

                    <group string="Invoice Amount">
                        <field name="subtotal"/>
                        <field name="vat_rate"/>
                        <field name="vat_amount"/>
                        <field name="grand_total"/>
                        <field name="payment_status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="invoice_action" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">business.invoice</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="invoice_menu"
              name="Invoices"
              parent="business_erp_root"
              action="invoice_action"
              sequence="4"/>

</odoo>