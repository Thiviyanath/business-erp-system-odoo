<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vehicle_sales_list" model="ir.ui.view">
        <field name="name">vehicle.sales.list</field>
        <field name="model">vehicle.sales</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_id"/>
                <field name="product_id"/>
                <field name="sale_date"/>
                <field name="sale_price"/>
                <field name="profit"/>
                <field name="payment_status"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_sales_form" model="ir.ui.view">
        <field name="name">vehicle.sales.form</field>
        <field name="model">vehicle.sales</field>
        <field name="arch" type="xml">
            <form string="Vehicle Sale">
                <sheet>
                    <group>
                        <field name="customer_id"/>
                        <field name="product_id"/>
                        <field name="sale_date"/>
                        <field name="sale_price"/>
                        <field name="profit" readonly="1"/>
                        <field name="payment_status"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vehicle_sales_graph" model="ir.ui.view">
        <field name="name">vehicle.sales.graph</field>
        <field name="model">vehicle.sales</field>
        <field name="arch" type="xml">
            <graph string="Sales Analytics" type="bar">
                <field name="product_id"/>
                <field name="sale_price" type="measure"/>
                <field name="profit" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="vehicle_sales_action" model="ir.actions.act_window">
        <field name="name">Vehicle Sales</field>
        <field name="res_model">vehicle.sales</field>
        <field name="view_mode">list,form,graph</field>
    </record>

    <menuitem id="vehicle_sales_menu"
              name="Vehicle Sales"
              parent="business_erp_root"
              action="vehicle_sales_action"
              sequence="3"/>

</odoo>